<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="transition" addfieldprefix="Joomla\Component\Workflow\Administrator\Field">
		<field
			name="id"
			type="hidden"
			label="JGLOBAL_FIELD_ID_LABEL"
			default="0"
			class="readonly"
			readonly="true"
		/>
		<field
			name="title"
			type="text"
			label="COM_WORKFLOW_FIELD_NAME_LABEL"
			required="true"
		/>
		<field
			name="from_stage_id"
			type="sql"
			label="COM_WORKFLOW_FROM_STAGE"
			required="true"
			sql_select="id as value, title as from_stage_id"
			sql_from="#__workflow_stages"
			sql_order="ordering"
			translate="true"
		>
			<option value="-1">JALL</option>
		</field>
		<field
			name="to_stage_id"
			type="sql"
			label="COM_WORKFLOW_TO_STAGE"
			required="true"
			sql_select="id as value, title as to_stage_id"
			sql_from="#__workflow_stages"
			sql_order="ordering"
			translate="true"
		/>
		<field
			name="description"
			type="textarea"
			label="COM_WORKFLOW_TRANSITION_NOTE"
			rows="3"
			cols="60"
		/>
	</fieldset>

	<fieldset name="params" label="COM_WORKFLOW_PARAMS_LABEL">
		<field
			name="published"
			type="list"
			label="COM_WORKFLOW_PUBLISHED_LABEL"
			required="true"
			class="form-select-color-state"
			default="1"
			validate="options"
		>
			<option value="1">JENABLED</option>
			<option value="0">JDISABLED</option>
			<option value="-2">JTRASHED</option>
		</field>
	</fieldset>

	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
		<field
			name="asset_id"
			type="hidden"
			filter="unset"
		/>
		<field
			name="rules"
			type="rules"
			label="JCONFIG_PERMISSIONS_LABEL"
			validate="rules"
			filter="rules"
			section="transition"
		/>
	</fieldset>
	<fields name="automation">
		<fieldset name="automation" label="COM_WORKFLOW_AUTOMATION_FIELDSET_LABEL">
			<field
				name="published"
				type="radio"
				layout="joomla.form.field.radio.switcher"
				label="COM_WORKFLOW_AUTOMATION_ENABLED_LABEL"
				description="COM_WORKFLOW_AUTOMATION_ENABLED_DESC"
				default="0"
			>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>

			<field
				name="rule_type"
				type="list"
				label="COM_WORKFLOW_AUTOMATION_RULE_TYPE_LABEL"
				description="COM_WORKFLOW_AUTOMATION_RULE_TYPE_DESC"
				default="interval"
				validate="options"
				showon="published:1"
			>
				<option value="interval">COM_WORKFLOW_AUTOMATION_RULE_TYPE_INTERVAL</option>
				<option value="cron">COM_WORKFLOW_AUTOMATION_RULE_TYPE_CRON</option>
			</field>

			<field
				name="interval_value"
				type="number"
				label="COM_WORKFLOW_AUTOMATION_INTERVAL_VALUE_LABEL"
				description="COM_WORKFLOW_AUTOMATION_INTERVAL_VALUE_DESC"
				min="1"
				showon="published:1[AND]rule_type:interval"
			/>

			<field
				name="interval_unit"
				type="list"
				label="COM_WORKFLOW_AUTOMATION_INTERVAL_UNIT_LABEL"
				default="minutes"
				validate="options"
				showon="published:1[AND]rule_type:interval"
			>
				<option value="minutes">COM_WORKFLOW_AUTOMATION_UNIT_MINUTES</option>
				<option value="hours">COM_WORKFLOW_AUTOMATION_UNIT_HOURS</option>
				<option value="days">COM_WORKFLOW_AUTOMATION_UNIT_DAYS</option>
				<option value="months">COM_WORKFLOW_AUTOMATION_UNIT_MONTHS</option>
			</field>

			<field
				name="cron_expression"
				type="text"
				label="COM_WORKFLOW_AUTOMATION_CRON_LABEL"
				description="COM_WORKFLOW_AUTOMATION_CRON_DESC"
				hint="*/5 * * * * "
				showon="published:1[AND]rule_type:cron"
			/>

			<field
				name="run_as_user_id"
				type="user"
				label="COM_WORKFLOW_AUTOMATION_RUN_AS_LABEL"
				description="COM_WORKFLOW_AUTOMATION_RUN_AS_DESC"
				showon="published:1"
			/>

			<field
				name="loop_mode"
				type="radio"
				layout="joomla.form.field.radio.switcher"
				label="COM_WORKFLOW_AUTOMATION_LOOP_MODE_LABEL"
				description="COM_WORKFLOW_AUTOMATION_LOOP_MODE_DESC"
				default="0"
				showon="published:1"
			>
				<option value="0">JNO</option>
				<option value="1">JYES</option>
			</field>
		</fieldset>
	</fields>
</form>
