<?xml version="1.0" encoding="UTF-8"?>
<form addfieldprefix="Joomla\Component\Workflow\Administrator\Field">
	<config>
		<inlinehelp button="show" />
	</config>

	<field
		name="rule_type"
		type="list"
		label="COM_WORKFLOW_AUTOMATION_RULE_TYPE_LABEL"
		description="COM_WORKFLOW_AUTOMATION_RULE_TYPE_DESC"
		default="interval"
		validate="options"
		parentclass="cb-delay cb-rule-type"
	>
		<option value="delay">COM_WORKFLOW_AUTOMATION_RULE_TYPE_DELAY</option>
		<option value="cron">COM_WORKFLOW_AUTOMATION_RULE_TYPE_CRON</option>
	</field>

	<field
		name="delay_value"
		type="number"
		label="COM_WORKFLOW_AUTOMATION_DELAY_VALUE_LABEL"
		description="COM_WORKFLOW_AUTOMATION_DELAY_VALUE_DESC"
		min="0"
		showon="rule_type:delay"
		parentclass="cb-delay cb-delay-value"
	/>

	<field
		name="delay_unit"
		type="list"
		label="COM_WORKFLOW_AUTOMATION_DELAY_UNIT_LABEL"
		description="COM_WORKFLOW_AUTOMATION_DELAY_UNIT_DESC"
		default="minutes"
		validate="options"
		showon="rule_type:delay"
		parentclass="cb-delay cb-delay-unit"
	>
		<option value="minutes">COM_WORKFLOW_AUTOMATION_UNIT_MINUTES</option>
		<option value="hours">COM_WORKFLOW_AUTOMATION_UNIT_HOURS</option>
		<option value="days">COM_WORKFLOW_AUTOMATION_UNIT_DAYS</option>
		<option value="months">COM_WORKFLOW_AUTOMATION_UNIT_MONTHS</option>
	</field>

	<field
		name="cron_expression"
		type="text"
		label="COM_WORKFLOW_AUTOMATION_CRON_LABEL"
		description="COM_WORKFLOW_AUTOMATION_CRON_DESC"
		hint="*/5 * * * *"
		showon="rule_type:cron"
		parentclass="cb-delay cb-cron"
	/>

	<field
		name="item_filter"
		type="conditionbuilder"
		mode="filter"
		label="COM_WORKFLOW_AUTOMATION_FILTER_LABEL"
		description="COM_WORKFLOW_AUTOMATION_FILTER_DESC"
	/>

	<field
		name="fire_condition"
		type="conditionbuilder"
		mode="condition"
		label="COM_WORKFLOW_AUTOMATION_CONDITION_LABEL"
		description="COM_WORKFLOW_AUTOMATION_CONDITION_DESC"
	/>
</form>
